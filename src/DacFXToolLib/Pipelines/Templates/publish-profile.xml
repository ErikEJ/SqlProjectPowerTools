<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the '{{EnvironmentName}}' environment
  Generated by SQL Database Project Power Tools

  The target server and database are passed by the pipeline from the
  'sql-{{EnvironmentName}}' variable group, SQLCMD variable values as well.
  Keep secrets out of this file.

  Guide: {{DocsUrl}}#publish-profiles-and-sqlcmd-variables
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetDatabaseName>{{DatabaseName}}</TargetDatabaseName>
    <ProfileVersionNumber>1</ProfileVersionNumber>
    <!-- Stop the deployment if data could be lost, for example a dropped column -->
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <!-- Objects that exist in the database but not in the project are kept -->
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <!-- Do not change database level settings - this also avoids the need for db_owner -->
    <ScriptDatabaseOptions>False</ScriptDatabaseOptions>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
    <IncludeTransactionalScripts>True</IncludeTransactionalScripts>
  </PropertyGroup>
</Project>
