<dw:DialogWindow x:Class="SqlProjectsPowerTools.PipelineWizardDialog"
                 xmlns:dw="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:viewModels="clr-namespace:SqlProjectsPowerTools"
                 mc:Ignorable="d"
                 ShowInTaskbar="False"
                 SizeToContent="Height"
                 Width="620"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 d:DataContext="{d:DesignInstance Type=viewModels:PipelineWizardViewModel, IsDesignTimeCreatable=False}">

    <dw:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Converter.xaml" />
                <ResourceDictionary Source="Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </dw:DialogWindow.Resources>

    <dw:DialogWindow.Background>
        <StaticResource ResourceKey="DialogWindowBackgroundColor" />
    </dw:DialogWindow.Background>

    <Grid Margin="12,8,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" TextWrapping="Wrap">
            Creates a starter Azure DevOps pipeline (build, plan, approve, deploy) for this project.
            <Hyperlink NavigateUri="https://github.com/ErikEJ/SqlProjectPowerTools/blob/main/docs/azure-devops-pipelines.md">Read the guide</Hyperlink>
        </TextBlock>

        <Label Grid.Row="1" Grid.Column="0" Content="_Target:" Target="{Binding ElementName=TargetCombo}" />
        <ComboBox x:Name="TargetCombo" Grid.Row="1" Grid.Column="1" Margin="0,2"
                  ItemsSource="{Binding TargetPlatforms}"
                  SelectedIndex="{Binding TargetPlatformIndex, Mode=TwoWay}" />

        <Label Grid.Row="2" Grid.Column="0" Content="_Agents:" Target="{Binding ElementName=AgentCombo}" />
        <ComboBox x:Name="AgentCombo" Grid.Row="2" Grid.Column="1" Margin="0,2"
                  ItemsSource="{Binding AgentPools}"
                  SelectedIndex="{Binding AgentPoolIndex, Mode=TwoWay}" />

        <Label Grid.Row="3" Grid.Column="0" Content="Agent _pool name:" Target="{Binding ElementName=PoolText}" />
        <TextBox x:Name="PoolText" Grid.Row="3" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                 IsEnabled="{Binding IsAgentPoolNameEnabled}"
                 Text="{Binding AgentPoolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="4" Grid.Column="0" Content="A_uthentication:" Target="{Binding ElementName=AuthCombo}" />
        <ComboBox x:Name="AuthCombo" Grid.Row="4" Grid.Column="1" Margin="0,2"
                  ItemsSource="{Binding Authentications}"
                  SelectedIndex="{Binding AuthenticationIndex, Mode=TwoWay}" />

        <Label Grid.Row="5" Grid.Column="0" Content="_Firewall:" Target="{Binding ElementName=FirewallCombo}" />
        <ComboBox x:Name="FirewallCombo" Grid.Row="5" Grid.Column="1" Margin="0,2"
                  ItemsSource="{Binding FirewallStrategies}"
                  SelectedIndex="{Binding FirewallStrategyIndex, Mode=TwoWay}" />

        <Label Grid.Row="6" Grid.Column="0" Content="_Service connection:" Target="{Binding ElementName=ConnectionText}" />
        <TextBox x:Name="ConnectionText" Grid.Row="6" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                 ToolTip="Name of the Azure Resource Manager service connection (workload identity federation)"
                 Text="{Binding ServiceConnectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="7" Grid.Column="0" Content="_Deployment identity:" Target="{Binding ElementName=IdentityText}" />
        <TextBox x:Name="IdentityText" Grid.Row="7" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                 IsEnabled="{Binding IsDeploymentIdentityEnabled}"
                 ToolTip="Display name of the app registration or managed identity used by the service connection"
                 Text="{Binding DeploymentIdentityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="8" Grid.Column="0" Content="_Environments:" Target="{Binding ElementName=EnvironmentsText}" />
        <TextBox x:Name="EnvironmentsText" Grid.Row="8" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                 ToolTip="Comma separated, in deployment order"
                 Text="{Binding EnvironmentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,2,0,6" TextWrapping="Wrap"
                   Foreground="{StaticResource DisabledTextBlockTextColor}"
                   Text="{Binding PlanSummary}" />

        <Label Grid.Row="10" Grid.Column="0" Content="Default _branch:" Target="{Binding ElementName=BranchText}" />
        <TextBox x:Name="BranchText" Grid.Row="10" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                 Text="{Binding DefaultBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Grid.Row="11" Grid.Column="1" Margin="0,6,0,2"
                  Content="Run code analysis during the build"
                  IsChecked="{Binding IncludeCodeAnalysis, Mode=TwoWay}" />

        <CheckBox Grid.Row="12" Grid.Column="1" Margin="0,2"
                  Content="Validate the deployment in a SQL Server container first"
                  IsChecked="{Binding IncludeContainerValidation, Mode=TwoWay}" />

        <Border Grid.Row="13" Grid.ColumnSpan="2"
                Background="#FFF5C600"
                Padding="8,4"
                Margin="0,8,0,0"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" Foreground="#FF000000" Text="{Binding Warning}" />
        </Border>

        <StackPanel Grid.Row="14" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12">
            <dw:DialogButton Content="OK"
                             IsDefault="True"
                             Margin="0,0,12,0"
                             Command="{Binding OkCommand}" />
            <dw:DialogButton Content="Cancel"
                             IsCancel="True"
                             Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</dw:DialogWindow>
